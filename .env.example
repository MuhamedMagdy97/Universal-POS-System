# Copy to .env and fill in. Never commit .env.

# PostgreSQL 16+ connection string (local) or a managed Neon/Supabase URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pos_dev?schema=public"

# Separate database used by `npm test` (integration tests write to it).
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pos_test?schema=public"

# Separate database used by `npm run test:e2e` (Playwright migrates + seeds it via
# prisma/seed-e2e.ts). Must differ from DATABASE_URL and TEST_DATABASE_URL.
E2E_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pos_e2e?schema=public"

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="CHANGE_ME"

# Public base URL of the app.
AUTH_URL="http://localhost:3000"

# Optional (Phase 13): seals the inventory-system API key at rest. 32 random bytes, base64.
# Without it a shop cannot be linked to the inventory system; everything else works.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# INTEGRATION_ENCRYPTION_KEY=""

# Optional (Phase 13): a linked shop's scheduler calls POST /api/internal/inventory/run every minute
# with header `x-cron-secret: <this>` to resend sales and refunds the inventory system missed. 32+ chars.
# CRON_SECRET=""
