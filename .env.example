# Copy to .env and fill in. Never commit .env.

# PostgreSQL 16+ connection string (local) or a managed Neon/Supabase URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pos_dev?schema=public"

# Separate database used by `npm test` (integration tests write to it).
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pos_test?schema=public"

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="CHANGE_ME"

# Public base URL of the app.
AUTH_URL="http://localhost:3000"
