// Universal POS System — MVP schema.
// Source of truth for the design: docs/architecture/database-design.md
//
// Conventions
// - Every tenant-scoped table carries `orgId`. Child rows reference their
//   parents through composite foreign keys `(orgId, parentId)`, so the
//   database itself rejects a row that points at another tenant's data.
// - Money is integer minor units (piastres / halalas) in `*Minor` columns.
//   No floats or decimals anywhere in finance.
// - Quantities are integers in the product's base unit (EACH = 1 piece,
//   KG = 1 gram). See lib/money.ts and modules/catalog for scaling.
// - VAT rates are basis points (1400 = 14%, 1500 = 15%).
// - InventoryMovement and AuditEvent are append-only; closed RegisterShifts
//   are immutable. Both are enforced by triggers in the init migration.
// - The User/Session/Account/Verification/RateLimit models follow the field
//   layout Better-Auth expects (lib/auth/auth.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum BusinessType {
  RETAIL
  GROCERY
  FRUIT_VEG
  BAKERY_BUTCHER
  RESTAURANT_CAFE
  SALON
}

enum Currency {
  EGP
  SAR
}

enum CountryCode {
  EG
  SA
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  REPORTING
}

enum UnitType {
  EACH
  KG
}

// Tax treatment for future e-invoicing (ZATCA / ETA). `Product.vatApplicable`
// is kept and must equal (vatCategory = STANDARD), enforced by a CHECK.
enum VatCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
}

enum MovementReason {
  OPENING_BALANCE
  SALE
  SALE_VOID
  REFUND
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

// Why goods went back to the supplier (purchase-returns-spec R5).
enum PurchaseReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  EXPIRED
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD_MANUAL
  WALLET
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
  DROP
}

// Phase 13 (integration spec I1): where stock, catalog and purchasing live for a shop.
enum InventorySource {
  BUILT_IN
  EXTERNAL
}

// Phase 13 slice 2 (I12–I15): what an inventory-system call is for.
enum PostingKind {
  FULFIL
  CANCEL
  RETURN
}

enum PostingStatus {
  PENDING
  DONE
  FAILED
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  LOST_OR_STOLEN
  COUNT_CORRECTION
  FOUND
  OTHER
}

enum StockCountStatus {
  DRAFT
  COUNTING
  POSTED
  CANCELLED
}

enum StockCountScope {
  FULL
  CATEGORY
  ITEMS
}

// ─────────────────────── Auth (Better-Auth) ───────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  // Tenant context chosen server-side after login; never accepted from the client.
  activeOrganizationId String?  @db.Uuid
  activeBranchId       String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Login rate-limit counters (Better-Auth `rateLimit.storage = "database"`).
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Business API rate limit (T10 H6): one row per user, org and bucket ("read", "write",
// "export"), fixed 60 s window. The upsert in lib/rate-limit.ts resets the count when the
// window rolls over, so the table never grows past three rows per member.
model ApiRateLimit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}

// ───────────────────── Tenancy: org / branch ─────────────────────

model Organization {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String
  businessType       BusinessType
  countryCode        CountryCode
  currency           Currency
  vatRateBp          Int
  blockNegativeStock Boolean         @default(true)
  // Shelf prices include VAT (EG and SA consumer pricing). Read by checkout (T6).
  pricesIncludeVat   Boolean         @default(true)
  // Last issued sale number (checkout): bumped in the sale transaction, gap-free on rollback.
  lastSaleNo         Int             @default(0)
  // Last issued purchase order number (T5): bumped in the PO create transaction, like lastSaleNo.
  lastPoNo           Int             @default(0)
  // Receipt fields
  legalName          String?
  taxNumber          String?
  receiptHeader      String?
  receiptFooter      String?
  receiptAddress     String?
  receiptPhone       String?
  // Phase 13 (I1): EXTERNAL = the inventory system is master; changed only through modules/integrations.
  inventorySource    InventorySource @default(BUILT_IN)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inventoryLink      InventoryLink?
  stockPostings      ExternalStockPosting[]
  branches           Branch[]
  registers          Register[]
  memberships        Membership[]
  membershipBranches MembershipBranch[]
  categories         Category[]
  products           Product[]
  variants           ProductVariant[]
  barcodes           Barcode[]
  stockBalances      StockBalance[]
  movements          InventoryMovement[]
  stockCounts        StockCount[]
  stockCountLines    StockCountLine[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  poItems            POItem[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptItems  GoodsReceiptItem[]
  purchaseReturns    PurchaseReturn[]
  returnItems        PurchaseReturnItem[]
  sales              Sale[]
  saleItems          SaleItem[]
  payments           Payment[]
  refunds            Refund[]
  refundItems        RefundItem[]
  shifts             RegisterShift[]
  cashMovements      CashMovement[]
  auditEvents        AuditEvent[]
}

// Phase 13 (I3): the shop's link to the inventory system. The API key is AES-256-GCM sealed
// (modules/integrations/inventory-sys/secret.ts) and never leaves the server.
model InventoryLink {
  orgId              String    @id @db.Uuid
  baseUrl            String
  apiKeyCiphertext   Bytes
  apiKeyKeyId        String
  apiKeyLast4        String
  lastCheckAt        DateTime?
  lastCheckOk        Boolean   @default(false)
  // Claimed by a running sync so two never overlap; cleared when it ends (stale after 10 min).
  syncLockedUntil    DateTime?
  lastSyncStartedAt  DateTime?
  lastSyncFinishedAt DateTime?
  lastSyncOk         Boolean?
  // Counts and skipped items only; never the key or IMS bodies.
  lastSyncSummary    Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
}

// Phase 13 slice 2 (I12–I15): one inventory-system call that must happen after a POS commit (a
// sale's fulfil, a refund's or void's return, the cancel of a refused sale's reservations). Written
// in the POS transaction, sent after it and retried until DONE; FAILED waits for a person.
model ExternalStockPosting {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @db.Uuid
  kind               PostingKind
  // "Sale" | "Refund" (their uuid), or "SaleAttempt" (hash of a refused sale's Idempotency-Key).
  sourceType         String
  sourceId           String
  // The merged sale line from 1 (FULFIL), the attempt number (SaleAttempt), else 0.
  lineNo             Int           @default(0)
  saleItemId         String?       @db.Uuid
  qty                Int           @default(0)
  idempotencyKey     String
  reservationId      String?
  reservationVersion Int?
  externalOrderRefId String?
  externalReturnId   String?
  status             PostingStatus @default(PENDING)
  attempts           Int           @default(0)
  nextAttemptAt      DateTime      @default(now())
  // The IMS `code` only, never its body.
  lastErrorCode      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([orgId, sourceType, sourceId])
}

model Branch {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @db.Uuid
  name                String
  code                String
  address             String?
  isActive            Boolean  @default(true)
  // Phase 13 (I5): the inventory-system warehouse this branch sells from when the shop is linked.
  externalWarehouseId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  registers          Register[]
  membershipBranches MembershipBranch[]
  stockBalances      StockBalance[]
  movements          InventoryMovement[]
  stockCounts        StockCount[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  purchaseReturns    PurchaseReturn[]
  sales              Sale[]
  refunds            Refund[]
  shifts             RegisterShift[]

  @@unique([orgId, id])
  @@unique([orgId, code])
}

model Register {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch Branch          @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  shifts RegisterShift[]
  sales  Sale[]

  @@unique([orgId, id])
  @@unique([orgId, branchId, id])
  @@unique([orgId, branchId, name])
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @db.Uuid
  userId      String         @db.Uuid
  role        MembershipRole
  // Owners/admins typically see all branches; others are scoped via MembershipBranch.
  allBranches Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]

  @@unique([orgId, userId])
  @@unique([orgId, id])
  @@index([userId])
}

model MembershipBranch {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  membershipId String   @db.Uuid
  branchId     String   @db.Uuid
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  membership Membership   @relation(fields: [orgId, membershipId], references: [orgId, id], onDelete: Cascade)
  branch     Branch       @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)

  @@unique([membershipId, branchId])
}

// ─────────────────────────── Catalog ───────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Inventory-system category id (category sync); unique per org (partial index in SQL).
  externalCategoryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sibling names are unique per (orgId, parentId), case-insensitive: raw SQL
  // index "Category_sibling_name_key" in the catalog_hardening migration.
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  parent   Category?    @relation("CategoryTree", fields: [orgId, parentId], references: [orgId, id], onDelete: Restrict)
  children Category[]   @relation("CategoryTree")
  products Product[]

  @@unique([orgId, id])
  @@index([orgId, parentId])
}

model Product {
  id                String      @id @default(uuid()) @db.Uuid
  orgId             String      @db.Uuid
  categoryId        String?     @db.Uuid
  sku               String
  name              String
  nameAr            String?
  unitType          UnitType    @default(EACH)
  priceMinor        Int
  costMinor         Int         @default(0)
  // Kept for existing readers; must equal (vatCategory = STANDARD) (DB CHECK).
  vatApplicable     Boolean     @default(true)
  vatCategory       VatCategory @default(STANDARD)
  // Set once the product has variants: every stock/sale line must then name a variant.
  hasVariants       Boolean     @default(false)
  // Deactivate instead of delete once referenced (business rule 8).
  isActive          Boolean     @default(true)
  // Phase 13 (I7, I9): ids in the inventory system (externalVariantId only on a product without
  // variants) and why a synced item cannot be sold. Unique per org (partial indexes in SQL).
  externalProductId String?
  externalVariantId String?
  notSellableReason String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  category      Category?            @relation(fields: [orgId, categoryId], references: [orgId, id], onDelete: Restrict)
  variants      ProductVariant[]
  barcodes      Barcode[]
  stockBalances StockBalance[]
  movements     InventoryMovement[]
  countLines    StockCountLine[]
  poItems       POItem[]
  receiptItems  GoodsReceiptItem[]
  returnItems   PurchaseReturnItem[]
  saleItems     SaleItem[]

  @@unique([orgId, id])
  @@unique([orgId, sku])
  @@index([orgId, categoryId])
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  productId         String   @db.Uuid
  sku               String
  name              String
  nameAr            String?
  // Null means "inherit the product price/cost".
  priceMinor        Int?
  costMinor         Int?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  externalVariantId String?
  notSellableReason String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  product         Product              @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  barcodes        Barcode[]            @relation("BarcodeVariant")
  productBarcodes Barcode[]            @relation("BarcodeVariantOfProduct")
  stockBalances   StockBalance[]
  movements       InventoryMovement[]
  countLines      StockCountLine[]
  poItems         POItem[]
  receiptItems    GoodsReceiptItem[]
  returnItems     PurchaseReturnItem[]
  saleItems       SaleItem[]

  @@unique([orgId, id])
  @@unique([orgId, sku])
  // Target for "variant belongs to this product" composite FKs (Barcode; T4/T6 reuse it).
  @@unique([orgId, productId, id])
  @@index([orgId, productId])
}

model Barcode {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  code      String
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  // The code printed on labels; at most one per product/variant (partial unique index in SQL).
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  product          Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant          ProductVariant? @relation("BarcodeVariant", fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)
  // The variant must belong to this barcode's product; a NULL variantId skips the check (MATCH SIMPLE).
  variantOfProduct ProductVariant? @relation("BarcodeVariantOfProduct", fields: [orgId, productId, variantId], references: [orgId, productId, id], onDelete: Restrict)

  @@unique([orgId, code])
  @@index([orgId, productId])
}

// ────────────────────────── Inventory ──────────────────────────

// Cache of on-hand quantity, reconciled against the InventoryMovement ledger.
// The unique key treats a NULL variantId as a value (NULLS NOT DISTINCT, see migration).
model StockBalance {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  branchId     String   @db.Uuid
  productId    String   @db.Uuid
  variantId    String?  @db.Uuid
  qty          Int      @default(0)
  // Reorder point (min qty) at this branch; null = not tracked. Low when qty <= reorderPoint.
  reorderPoint Int?
  updatedAt    DateTime @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch  Branch          @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  product Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, branchId, productId, variantId])
  @@index([orgId, branchId])
}

// Append-only ledger (UPDATE/DELETE rejected by trigger).
model InventoryMovement {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @db.Uuid
  branchId         String            @db.Uuid
  productId        String            @db.Uuid
  variantId        String?           @db.Uuid
  qtyDelta         Int
  reason           MovementReason
  // Set only for ADJUSTMENT rows (DB CHECK); drives the direction rules.
  adjustmentReason AdjustmentReason?
  // Source document, e.g. ("Sale", saleId) or ("GoodsReceipt", receiptId).
  refType          String?
  refId            String?           @db.Uuid
  // Pairs the OUT and IN rows of a branch transfer.
  transferGroupId  String?           @db.Uuid
  note             String?
  actorUserId      String            @db.Uuid
  createdAt        DateTime          @default(now())

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch  Branch          @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  product Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, branchId, productId, variantId, createdAt])
  @@index([orgId, refType, refId])
  @@index([orgId, transferGroupId])
}

// Stock count session (docs/planning/stock-counts/stock-counts-spec.md). One open count per branch
// (partial unique index in SQL). Posting writes ADJUSTMENT/COUNT_CORRECTION rows with refType "StockCount".
model StockCount {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  branchId        String           @db.Uuid
  status          StockCountStatus @default(DRAFT)
  scope           StockCountScope
  // Set only for CATEGORY scope (DB CHECK); sub-categories are included.
  categoryId      String?          @db.Uuid
  note            String?
  createdByUserId String           @db.Uuid
  postedByUserId  String?          @db.Uuid
  postedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch Branch           @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  lines  StockCountLine[]

  @@unique([orgId, id])
  @@index([orgId, branchId, createdAt])
}

model StockCountLine {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  countId      String    @db.Uuid
  productId    String    @db.Uuid
  variantId    String?   @db.Uuid
  // Null until counted. expectedQty is on-hand when first counted (both set or both null, DB CHECK).
  countedQty   Int?
  expectedQty  Int?
  countedAt    DateTime?
  // Filled when the count is posted.
  onHandAtPost Int?
  qtyDelta     Int?
  updatedAt    DateTime  @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  count   StockCount      @relation(fields: [orgId, countId], references: [orgId, id], onDelete: Cascade)
  product Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, countId, productId, variantId])
}

// ────────────────────────── Purchasing ──────────────────────────

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  phone     String?
  email     String?
  taxNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([orgId, id])
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @db.Uuid
  branchId    String              @db.Uuid
  supplierId  String              @db.Uuid
  number      String
  status      PurchaseOrderStatus @default(DRAFT)
  createdById String              @db.Uuid
  note        String?
  // Set when marked ORDERED (purchasing-data-model-and-api.md §1).
  orderedAt   DateTime?
  // Set when CANCELLED or RECEIVED; closeReason explains a cancel or a short close.
  closedAt    DateTime?
  closeReason String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch   Branch           @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  supplier Supplier         @relation(fields: [orgId, supplierId], references: [orgId, id], onDelete: Restrict)
  items    POItem[]
  receipts GoodsReceipt[]
  returns  PurchaseReturn[]

  @@unique([orgId, id])
  @@unique([orgId, number])
  @@index([orgId, status, branchId])
  @@index([orgId, supplierId])
}

model POItem {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @db.Uuid
  purchaseOrderId String  @db.Uuid
  productId       String  @db.Uuid
  variantId       String? @db.Uuid
  qtyOrdered      Int
  qtyReceived     Int     @default(0)
  // Units sent back to the supplier (purchase-returns-spec R2); CHECK 0 ≤ qtyReturned ≤ qtyReceived.
  qtyReturned     Int     @default(0)
  unitCostMinor   Int

  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder        @relation(fields: [orgId, purchaseOrderId], references: [orgId, id], onDelete: Cascade)
  product       Product              @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant       ProductVariant?      @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]
  returnItems   PurchaseReturnItem[]

  @@unique([orgId, id])
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  branchId        String   @db.Uuid
  purchaseOrderId String   @db.Uuid
  idempotencyKey  String
  // sha256 of the canonical request body: a replayed key must carry the same receipt (P10).
  requestHash     String
  receivedById    String   @db.Uuid
  note            String?
  receivedAt      DateTime @default(now())

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch        Branch             @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [orgId, purchaseOrderId], references: [orgId, id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, branchId, receivedAt])
  @@index([orgId, purchaseOrderId])
}

model GoodsReceiptItem {
  id             String  @id @default(uuid()) @db.Uuid
  orgId          String  @db.Uuid
  goodsReceiptId String  @db.Uuid
  poItemId       String  @db.Uuid
  productId      String  @db.Uuid
  variantId      String? @db.Uuid
  qtyReceived    Int
  unitCostMinor  Int

  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goodsReceipt GoodsReceipt    @relation(fields: [orgId, goodsReceiptId], references: [orgId, id], onDelete: Restrict)
  poItem       POItem          @relation(fields: [orgId, poItemId], references: [orgId, id], onDelete: Restrict)
  product      Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)
}

// Goods sent back to the supplier against a PO (purchase-returns-spec). Append-only, like receipts.
model PurchaseReturn {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @db.Uuid
  branchId        String               @db.Uuid
  purchaseOrderId String               @db.Uuid
  // 1, 2, … per PO, taken under the PO lock; shown as PO-000123-R1 (R9).
  seq             Int
  reason          PurchaseReturnReason
  note            String?
  idempotencyKey  String
  // sha256 of the canonical request body, like GoodsReceipt (R7).
  requestHash     String
  returnedById    String               @db.Uuid
  returnedAt      DateTime             @default(now())

  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder        @relation(fields: [orgId, purchaseOrderId], references: [orgId, id], onDelete: Restrict)
  items         PurchaseReturnItem[]

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, purchaseOrderId, seq])
  @@index([orgId, branchId, returnedAt])
}

model PurchaseReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  orgId            String  @db.Uuid
  purchaseReturnId String  @db.Uuid
  poItemId         String  @db.Uuid
  productId        String  @db.Uuid
  variantId        String? @db.Uuid
  qty              Int
  // The PO line's unit cost (R4).
  unitCostMinor    Int

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  purchaseReturn PurchaseReturn  @relation(fields: [orgId, purchaseReturnId], references: [orgId, id], onDelete: Restrict)
  poItem         POItem          @relation(fields: [orgId, poItemId], references: [orgId, id], onDelete: Restrict)
  product        Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)
}

// ──────────────────────────── Sales ────────────────────────────

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @db.Uuid
  branchId       String     @db.Uuid
  registerId     String     @db.Uuid
  shiftId        String     @db.Uuid
  cashierId      String     @db.Uuid
  number         String
  idempotencyKey String
  status         SaleStatus @default(COMPLETED)
  currency       Currency
  subtotalMinor  Int
  discountMinor  Int        @default(0)
  vatMinor       Int
  totalMinor     Int
  // Cash handed back to the customer (tendered cash minus the cash applied to the sale).
  changeMinor    Int        @default(0)
  // SHA-256 of the canonical request body; a replayed Idempotency-Key must match it.
  requestHash    String?
  createdAt      DateTime   @default(now())
  voidedAt       DateTime?
  voidedById     String?    @db.Uuid
  voidReason     String?

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  register Register      @relation(fields: [orgId, branchId, registerId], references: [orgId, branchId, id], onDelete: Restrict)
  shift    RegisterShift @relation(fields: [orgId, shiftId], references: [orgId, id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]
  refunds  Refund[]

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, number])
  @@index([orgId, branchId, createdAt])
  @@index([orgId, shiftId])
}

// Snapshot of product data at sale time; later price edits never touch it.
model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  saleId         String   @db.Uuid
  productId      String   @db.Uuid
  variantId      String?  @db.Uuid
  skuSnapshot    String
  nameSnapshot   String
  nameArSnapshot String?
  unitType       UnitType
  qty            Int
  unitPriceMinor Int
  discountMinor  Int      @default(0)
  vatRateBp      Int
  vatMinor       Int
  lineTotalMinor Int
  // Cost per unit before VAT at the moment of sale (P12 M1). NULL = unknown: cost 0 or a sale
  // made before P12 (M2, M6). Never returned by the sales API or the receipt (M10).
  unitCostMinor  Int?

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sale        Sale            @relation(fields: [orgId, saleId], references: [orgId, id], onDelete: Restrict)
  product     Product         @relation(fields: [orgId, productId], references: [orgId, id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [orgId, variantId], references: [orgId, id], onDelete: Restrict)
  refundItems RefundItem[]

  @@unique([orgId, id])
  @@index([orgId, saleId])
}

// Split tender: one row per payment method used on a sale.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @db.Uuid
  saleId      String        @db.Uuid
  method      PaymentMethod
  amountMinor Int
  // Manual reference (card slip / wallet transaction id). Never raw card data.
  reference   String?
  createdAt   DateTime      @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sale Sale         @relation(fields: [orgId, saleId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, saleId])
}

model Refund {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  branchId       String        @db.Uuid
  saleId         String        @db.Uuid
  shiftId        String?       @db.Uuid
  processedById  String        @db.Uuid
  idempotencyKey String
  // Hash of the canonical request body, so a replay with another body is refused (as on Sale).
  requestHash    String?
  method         PaymentMethod
  // Manual reference (card slip / wallet transaction id). Never raw card data.
  reference      String?
  reason         String
  totalMinor     Int
  vatMinor       Int
  createdAt      DateTime      @default(now())

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch Branch         @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  sale   Sale           @relation(fields: [orgId, saleId], references: [orgId, id], onDelete: Restrict)
  shift  RegisterShift? @relation(fields: [orgId, shiftId], references: [orgId, id], onDelete: Restrict)
  items  RefundItem[]

  @@unique([orgId, id])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, saleId])
}

model RefundItem {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @db.Uuid
  refundId    String @db.Uuid
  saleItemId  String @db.Uuid
  qty         Int
  amountMinor Int
  vatMinor    Int

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  refund   Refund       @relation(fields: [orgId, refundId], references: [orgId, id], onDelete: Restrict)
  saleItem SaleItem     @relation(fields: [orgId, saleItemId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, saleItemId])
}

// ─────────────────────── Registers / shifts ───────────────────────

// OPEN → CLOSED; a CLOSED shift is immutable (trigger). At most one OPEN
// shift per register (partial unique index in the migration).
model RegisterShift {
  id                String      @id @default(uuid()) @db.Uuid
  orgId             String      @db.Uuid
  branchId          String      @db.Uuid
  registerId        String      @db.Uuid
  status            ShiftStatus @default(OPEN)
  openedById        String      @db.Uuid
  openedAt          DateTime    @default(now())
  openingFloatMinor Int
  closedById        String?     @db.Uuid
  closedAt          DateTime?
  expectedCashMinor Int?
  countedCashMinor  Int?
  discrepancyMinor  Int?
  discrepancyNote   String?

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Restrict)
  register      Register       @relation(fields: [orgId, branchId, registerId], references: [orgId, branchId, id], onDelete: Restrict)
  sales         Sale[]
  refunds       Refund[]
  cashMovements CashMovement[]

  @@unique([orgId, id])
  @@index([orgId, registerId, status])
}

model CashMovement {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @db.Uuid
  shiftId     String           @db.Uuid
  type        CashMovementType
  amountMinor Int
  reason      String
  actorUserId String           @db.Uuid
  createdAt   DateTime         @default(now())

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  shift RegisterShift @relation(fields: [orgId, shiftId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, shiftId])
}

// ──────────────────────────── Audit ────────────────────────────

// Append-only (UPDATE/DELETE rejected by trigger). `metadata` must never hold secrets.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String?  @db.Uuid
  branchId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
}
